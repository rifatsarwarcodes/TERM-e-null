# Example exam package for OV_C.
# The passcode below is the hash of "examiner". Create your own with ovc --setup.

[exam]
code = SWE4304-LT2
title = Lab Test 2: Balanced Brackets
time_limit = 90
sessions = sessions/LT2
compiler = g++
flags = -std=c++17 -O2 -Wall
run_time_limit = 2
passcode = sha256-iter:10000:3b9f1c6a0e4d4b2a9c1e5f7a8b6d2c40:998ffa86689f190ad5797c234048eea4a929a7fb87e3cf3112b0c5a95e71f138

[problem]
Read q strings made only of the characters ()[]{}. For each one, print YES if
the brackets are balanced and NO otherwise.

Input
  line 1: q (1 <= q <= 1000)
  next q lines: one string each (length up to 10^5)

Output
  YES or NO, one per line

[test 1]
input <<<
3
()
([)]
{[]}
>>>
output <<<
YES
NO
YES
>>>

[test 2]
input <<<
2
((
}
>>>
output <<<
NO
NO
>>>

[allowed]
file = template.cpp

[policy]
small_paste_chars = 80
small_paste_lines = 2
large_paste_chars = 300
large_paste_lines = 10
large_paste_points = 3
repeat_count = 3
repeat_window_min = 10
repeat_points = 2
focus_return_sec = 60
focus_return_points = 2
unchanged_ratio = 0.80
unchanged_points = 3
passcode_fail_limit = 3
warning_at = 3
flagged_at = 8
